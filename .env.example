# ============================================================
# ShramAI Environment Configuration
# ============================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="ShramAI — Labour Compliance & Inspection Intelligence"
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32bytes_minimum

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shram_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shram_db

# Redis (Caching & Task Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers (OpenAI / Google Gemini / Ollama fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-pro

# Embeddings & Vector Store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_TYPE=pgvector # pgvector or chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# Document Storage & OCR
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
OCR_ENGINE=paddleocr # paddleocr or tesseract
OCR_USE_GPU=False

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
